# Microsoft Form
FORM_URL=https://forms.cloud.microsoft/pages/responsepage.aspx?id=0AXnVXRck0GwwTa-4NQ-bvGJJtgnRZ5Fseet11Dp2IdUNDM3UUNaSVQySjBDSzc5WExJUzVOM0lLNS4u&origin=lprLink&route=shorturl

# Render Key Value / Redis
REDIS_URL=

# Dashboard authentication
REVIEW_USER=admin
REVIEW_PASSWORD=change-this-to-a-strong-password

# Safety switch:
# Keep false during your first deployment test.
# Set true only after you have confirmed the dashboard + approval flow works.
ALLOW_SUBMIT=false

# India timezone and daily cutoff.
TIMEZONE=Asia/Kolkata
RUN_HOUR_IST=20
RUN_MINUTE_IST=0
CUTOFF_HOUR_IST=20
CUTOFF_MINUTE_IST=58

# Polling and retention
APPROVAL_POLL_SECONDS=5
STATE_TTL_SECONDS=604800
HISTORY_TTL_SECONDS=7776000

# Optional
PORT=10000
